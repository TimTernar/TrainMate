<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.ViewTelovadba"
             Title="ViewTelovadba">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Workouts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,8"
                    Padding="12"
                    BackgroundColor="#1E1E1E"
                    StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="10">
                            <!--Prikaz imena telovadbe-->
                            <Label Text="{Binding Name}" 
                                   Style="{StaticResource WorkoutName}"/>
                            <CollectionView ItemsSource="{Binding Exercises}" >
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <!--Prikaz posebnej vaj-->
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Key}"
                                                   Style="{StaticResource ExerciseName}"/>

                                            <!--|Set |  Exercise   | kg |Rep | ✓  |-->
                                            <Grid ColumnDefinitions="40,*,70,70,40">
                                                <Label Text="Set" TextColor="CornflowerBlue"/>
                                                <Label Text="Previous" Grid.Column="1" TextColor="CornflowerBlue"/>
                                                <Label Text="kg" Grid.Column="2" HorizontalTextAlignment="Center" TextColor="CornflowerBlue"/>
                                                <Label Text="Reps" Grid.Column="3" HorizontalTextAlignment="Center" TextColor="CornflowerBlue"/>
                                            </Grid>

                                            <CollectionView ItemsSource="{Binding Value.Sets.Values}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="40,*,70,70,40"
                                                              Padding="4">

                                                            <!--Set-->
                                                            <Label Text="{Binding SetNumber}"
                                                                   TextColor="Black"/>

                                                            <Label Text="{Binding Reps}"
                                                                   TextColor="Gray"
                                                                   Grid.Column="1"/>

                                                            <Label Text="{Binding Weight}"
                                                                   TextColor="Black"
                                                                   Grid.Column="2"
                                                                    HorizontalTextAlignment="Center"/>

                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                                            
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>