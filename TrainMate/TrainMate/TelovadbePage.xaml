<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.TelovadbePage"
             Title="TelovadbePage">

    <VerticalStackLayout>

        <CollectionView x:Name="WorkoutList"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding}"
                           FontSize="18"
                           Padding="12"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Add Workout"
                Clicked="AddWorkout"/>

    </VerticalStackLayout>
</ContentPage>
