<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.ViewTelovadba"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource RedBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="16">

            <CollectionView ItemsSource="{Binding ExerciseRows}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border Style="{StaticResource WorkoutCardBorder}">
                            <VerticalStackLayout Spacing="0">

                                <Grid Style="{StaticResource WorkoutHeaderGrid}"
                                      ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource ExerciseTitleLabel}" />

                                    <Switch Grid.Column="1"
                                            IsToggled="True"
                                            Scale="0.85"
                                            IsEnabled="False" />
                                </Grid>

                                <BoxView Style="{StaticResource WorkoutDivider}" />

                                <Grid Style="{StaticResource WorkoutTableHeaderGrid}"
                                      ColumnDefinitions="55,*"
                                      ColumnSpacing="10">

                                    <Label Text="Set" Style="{StaticResource WorkoutHeaderLabel}" />
                                    <Label Grid.Column="1" Text="Previous" Style="{StaticResource WorkoutHeaderLabel}" />
                                </Grid>

                                <CollectionView ItemsSource="{Binding Sets}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>

                                            <Grid Style="{StaticResource WorkoutSetRowGrid}"
                                                  ColumnDefinitions="55,*"
                                                  ColumnSpacing="10">

                                                <Label Text="•"
                                                       Style="{StaticResource WorkoutCellLabel}" />

                                                <Label Grid.Column="1"
                                                       Style="{StaticResource WorkoutPrevLabel}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Weight}" />
                                                            <Span Text=" kg x " />
                                                            <Span Text="{Binding Reps}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                            </Grid>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
