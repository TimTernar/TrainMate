<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.ZgodovinaPage"
             Title="History"
             BackgroundColor="{StaticResource RedBackground}">

    <VerticalStackLayout Padding="12" Spacing="14">

        <Border BackgroundColor="White"
                Stroke="#D6D6D6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle16"
                Padding="12">

            <Border.Shadow>
                <Shadow Opacity="0.18" Radius="10" Offset="0,4"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Button Text="‹"
                            Command="{Binding PrevMonthCommand}"
                            WidthRequest="44"
                            HeightRequest="44"/>

                    <Label Grid.Column="1"
                           Text="{Binding MonthTitle}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>

                    <Button Grid.Column="2"
                            Text="›"
                            Command="{Binding NextMonthCommand}"
                            WidthRequest="44"
                            HeightRequest="44"/>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#EAEAEA" Margin="0,2,0,2"/>

                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="0">
                    <Label Text="Su" HorizontalTextAlignment="Center" />
                    <Label Text="Mo" Grid.Column="1" HorizontalTextAlignment="Center" />
                    <Label Text="Tu" Grid.Column="2" HorizontalTextAlignment="Center" />
                    <Label Text="We" Grid.Column="3" HorizontalTextAlignment="Center" />
                    <Label Text="Th" Grid.Column="4" HorizontalTextAlignment="Center" />
                    <Label Text="Fr" Grid.Column="5" HorizontalTextAlignment="Center" />
                    <Label Text="Sa" Grid.Column="6" HorizontalTextAlignment="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding Days}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedDay}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="#E0E0E0"
                                    Padding="8"
                                    Margin="2"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    StrokeShape="RoundRectangle8">

                                <Label Text="{Binding DayNumber}"
                                       TextColor="{Binding TextColor}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       Opacity="{Binding Opacity}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        <Border BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle16"
                Padding="12"
                IsVisible="{Binding HasSelectedWorkout}">

            <VerticalStackLayout Spacing="10">

                <Label Text="{Binding SelectedWorkoutTitle}"
                       FontAttributes="Bold"
                       FontSize="14" />

                <BoxView HeightRequest="1" BackgroundColor="#EAEAEA" />

                <CollectionView ItemsSource="{Binding SelectedWorkoutLines}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="2,8">
                                <Label Text="{Binding ExerciseName}" FontSize="14" />
                                <Label Grid.Column="1" Text="{Binding SetsText}" FontSize="14" TextColor="#6B6B6B"/>
                                <Label Grid.Column="2" Text="{Binding WeightText}" FontSize="14" TextColor="#6B6B6B"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
