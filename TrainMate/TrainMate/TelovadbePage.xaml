<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.TelovadbePage"
             Title="TelovadbePage">

    <VerticalStackLayout>

        <CollectionView x:Name="WorkoutList"
                        VerticalOptions="FillAndExpand"
                        SelectionMode="Single"
                        SelectionChanged="WorkoutList_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <BoxView HeightRequest="1"
                           Color="Gray"
                           HorizontalOptions="FillAndExpand"
                           Margin="12,0,12,0" />

                        <Label Text="{Binding Name}"
                            FontSize="18"
                            Padding="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Add Workout"
                Style="{StaticResource AddWorkoutButton}"
                Clicked="AddWorkout"/>

        <Button Text="Delete Workout"
                Style="{StaticResource DeleteWorkout}"
                />

    </VerticalStackLayout>
</ContentPage>
