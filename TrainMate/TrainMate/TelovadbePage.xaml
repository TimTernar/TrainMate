<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.TelovadbePage"
             Title="TelovadbePage">
    <VerticalStackLayout>
        <TableView Intent="Menu">
            <TableRoot>
                <TableSection x:Name="WorkoutSelection"  Title="Workouts">
                    <TextCell Text="1. Introduction to TrainMate"
                      Detail="Learn about TrainMate what it provides." />
                </TableSection>
            </TableRoot>
        </TableView>

        <Button Text="Add Workout"
                Clicked="AddWorkout"/>

    </VerticalStackLayout>
</ContentPage>