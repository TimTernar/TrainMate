<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrainMate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TrainMate"
    Shell.FlyoutBehavior="Disabled">

    <!-- Tukaj lahko nastavita MainPage kot začetni page. Zaenkrat je začetna stran "HomePage" ker je delo lažje potem
    <ShellContent
        Route="main"
        ContentTemplate="{DataTemplate pages:MainPage}" />
    -->
    <TabBar Route="tabs">
        <ShellContent
            Title="Home"
            Icon="homepage.png"
            Route="home"
            ContentTemplate="{DataTemplate pages:HomePage}" />

        <ShellContent
            Title="Workouts"
            Icon="dumbell.png"
            Route="workouts"
            ContentTemplate="{DataTemplate pages:TelovadbePage}" />

        <ShellContent
            Title="Profile"
            Icon="profile.png"
            Route="profile"
            ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>
</Shell>
