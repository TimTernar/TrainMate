<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainMate.ReceptiPage"
             Title="Recepies"
             BackgroundColor="{StaticResource RedBackground}">

    <Grid RowDefinitions="Auto,*" Padding="12">

        <!-- loading -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"/>

        <!-- list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Recepti}"
                        SelectionMode="None"
                        Margin="0,8,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,18">

                        <Border StrokeShape="RoundRectangle16"
                                Padding="0"
                                HeightRequest="150"
                                WidthRequest="150"
                                HorizontalOptions="Start">

                            <!-- clickable like your tile -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnRecipeTapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Image Source="{Binding Image}"
                                   Aspect="AspectFill"/>
                        </Border>

                        <Label Text="{Binding Type}"
                               FontSize="12"
                               TextColor="#6B6B6B"/>

                        <Label Text="{Binding Name}"
                               FontSize="14"
                               FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
